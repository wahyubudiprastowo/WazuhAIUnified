DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8088
# Set a strong shared access token before exposing the dashboard. Browser login:
# configured username and token as password. Requires HTTPS at the reverse proxy.
DASHBOARD_ACCESS_USERNAME=soc
DASHBOARD_ACCESS_TOKEN=
# Separate additive workflow database; existing automation/history is unchanged.
SOC_WORKFLOW_DB=/app/runtime/soc-workflows.db
DASHBOARD_HOST_PORT=8088

GENSECAI_MCP_URL=http://wazuh-main-server:3000
GENSECAI_API_KEY=__GENSECAI_API_KEY__

INFOKOM_MCP_URL=http://wazuh-infokom-mcp:8000/mcp
INFOKOM_API_KEY=__INFOKOM_API_KEY__

WAZUH_DOCKER_NETWORK=single-node_default

# Dashboard snapshot cache. Repeated page opens/time-filter reads use this
# cache instead of re-querying the indexer and provider tools on every view.
SOC_OVERVIEW_CACHE_TTL_SECONDS=300
SOC_PREWARM_ENABLED=true
SOC_PREWARM_RANGES=24h
SOC_INDEXER_MAX_CONCURRENT_QUERIES=6
SOC_INDEXER_ACQUIRE_TIMEOUT_SECONDS=5
# Read-only local CMDB mounted by docker-compose. The dashboard caches it by
# file version and never queries Wazuh or threat-intelligence providers per asset.
# See cmdb.schema.json and cmdb.example.json. Legacy top-level arrays remain supported.
DASHBOARD_CMDB_DIR=../infokom-analysis/resource
SOC_CMDB_FILE=/app/cmdb/assets.json
SOC_INTERVAL_SECONDS=900
SOC_REPORT_RETENTION_DAYS=180
SOC_STREAM_REPLAY_INTERVAL_SECONDS=1800
SOC_STREAM_SCAN_PAUSE_SECONDS=10
# Dedicated materializer bounds each Indexer scroll and page. Leave these
# conservative until a controlled 1M/3M/10M replay benchmark is complete.
SOC_STREAM_WINDOW_SECONDS=300
SOC_STREAM_PAGE_SIZE=500
SOC_MATERIALIZER_CPUS=1.0
SOC_MATERIALIZER_MEMORY_LIMIT=768m
SOC_ROLLUP_ENABLED=true
SOC_ROLLUP_RETENTION_DAYS=180
SOC_ENTITY_RETENTION_DAYS=30
SOC_ENTITY_MAX_EVIDENCE_PER_WINDOW=500
SOC_ENTITY_DRAIN_BATCH_SIZE=100
SOC_ROLLUP_BACKFILL_ENABLED=true
SOC_ROLLUP_BACKFILL_DAYS=30
SOC_ROLLUP_BACKFILL_CHUNK_MINUTES=30
SOC_ROLLUP_BACKFILL_MAX_CHUNK_MINUTES=120
SOC_ROLLUP_BACKFILL_INTERVAL_SECONDS=120
SOC_ROLLUP_BACKFILL_MIN_INTERVAL_SECONDS=30
SOC_ROLLUP_BACKFILL_FAST_QUERY_MS=1500
# Runs only after the broad historical rollup is complete. It queries the
# Forti decoder only and stores IPS/malware counters, never raw alert payloads.
SOC_FORTI_SECURITY_BACKFILL_ENABLED=true
SOC_FORTI_SECURITY_BACKFILL_CHUNK_MINUTES=120
SOC_FORTI_SECURITY_BACKFILL_INTERVAL_SECONDS=60
SOC_QUEUE_BATCH_SIZE=75
SOC_IOC_BUDGET=10
SOC_CVE_BUDGET=5
SOC_CVE_SNAPSHOT_LIMIT=50
SOC_ENRICHMENT_MAX_SECONDS=420
SOC_PROVIDER_OK_CACHE_SECONDS=21600
SOC_PROVIDER_ERROR_BACKOFF_SECONDS=14400
SOC_CYFIRMA_FEED_CACHE_SECONDS=1800
# The worker rotates this bounded page size through the feed using a durable
# local cursor. Larger values increase API response size, not dashboard speed.
SOC_CYFIRMA_PAGE_SIZE=20
SOC_CYFIRMA_MAX_PAGES=10
SOC_CYFIRMA_MAX_SECONDS=90
# Optional manual public-IP list. These IPs are queued for the normal provider
# consensus workflow; this setting does not assert they came from CrowdSec.
CROWDSEC_WATCHLIST_IPS=
# Public research is intentionally separate from authenticated STIX IOC feeds.
# It is disabled by default and stores only listing metadata in local SQLite.
SOC_CYFIRMA_RESEARCH_ENABLED=false
SOC_CYFIRMA_RESEARCH_URL=https://www.cyfirma.com/research/
SOC_CYFIRMA_RESEARCH_INTERVAL_SECONDS=21600
SOC_CYFIRMA_RESEARCH_MAX_ITEMS=25
# Optional TAXII 2.1 collection. Obtain the exact collection URL and bearer
# token from CYFIRMA; bespoke STIX indicator endpoints are not TAXII URLs.
SOC_CYFIRMA_TAXII_ENABLED=false
SOC_CYFIRMA_TAXII_COLLECTION_URL=
SOC_CYFIRMA_TAXII_BEARER_TOKEN=
SOC_CYFIRMA_TAXII_INTERVAL_SECONDS=21600
SOC_CYFIRMA_TAXII_MAX_ITEMS=50
SOC_CYFIRMA_TAXII_MAX_PAGES=2
# CYFIRMA Organization API V2 vulnerability STIX. Use a regenerated Org key;
# this collector fetches one recent, bounded page and stores it locally.
SOC_CYFIRMA_ORG_VULN_ENABLED=false
SOC_CYFIRMA_ORG_VULN_API_KEY=
SOC_CYFIRMA_ORG_VULN_URL=https://decyfir.cyfirma.com/core/api-ua/stix-v2.1/v2/vulnerabilities
SOC_CYFIRMA_ORG_VULN_INTERVAL_SECONDS=21600
SOC_CYFIRMA_ORG_VULN_LOOKBACK_DAYS=30
SOC_CYFIRMA_ORG_VULN_PAGE_SIZE=50
SOC_CYFIRMA_ORG_VULN_MAX_PAGES=2
SOC_PROVIDER_HISTORY_RETENTION_DAYS=180
HERMES_AGENT_ENABLED=false
HERMES_AGENT_URL=

# Optional Microsoft Defender XDR alert collection. This uses a distinct app
# registration with Defender XDR application permissions and is disabled until
# its tenant/client/secret are configured.
DEFENDER_XDR_ENABLED=false
DEFENDER_XDR_TENANT_ID=
DEFENDER_XDR_CLIENT_ID=
DEFENDER_XDR_CLIENT_SECRET=
# `graph` uses Microsoft Graph SecurityIncident.Read.All. `defender` uses
# Microsoft Threat Protection Incident.Read.All.
# Use Graph when Entra application permissions SecurityAlert.Read.All and
# SecurityIncident.Read.All have admin consent.
DEFENDER_XDR_API_PROVIDER=graph
# Default: incidents requires Microsoft Threat Protection / Incident.Read.All.
# The legacy alerts mode requires Alert.ReadWrite.All even for read access.
# `both` collects incidents and alerts_v2; use `alerts` if only
# SecurityAlert.Read.All is granted.
DEFENDER_XDR_COLLECTION_MODE=both
DEFENDER_XDR_API_BASE_URL=https://api.security.microsoft.com
DEFENDER_XDR_POLL_INTERVAL_SECONDS=900
DEFENDER_XDR_BATCH_SIZE=50

# Optional AI analyst agent. Keep disabled until a real OpenAI-compatible
# endpoint and key are available.
AI_ANALYST_ENABLED=false
AI_AUTO_ANALYZE=false
AI_PROVIDER_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.1:8b
AI_API_KEY=__AI_API_KEY__
AI_MEMORY_REPORTS=4
AI_FINDING_CACHE_SECONDS=86400
AI_FINDING_LEASE_SECONDS=300
AI_FALLBACK_ENABLED=true
AI_TIMEOUT_SECONDS=180
AI_MAX_TOKENS=1600

# Microsoft 365 delivery requires application OAuth2 authorization, not a mailbox password.
SOC_EMAIL_ENABLED=false
SOC_SMTP_HOST=smtp.office365.com
SOC_SMTP_PORT=587
SOC_SMTP_AUTH=password
SOC_SMTP_USER=
SOC_SMTP_FROM=
SOC_SMTP_OAUTH_USE_M365=false
SOC_SMTP_OAUTH_TENANT_ID=
SOC_SMTP_OAUTH_CLIENT_ID=
SOC_SMTP_OAUTH_CLIENT_SECRET=
SOC_DELIVERY_INTERVAL_SECONDS=86400
SOC_DELIVERY_ERROR_BACKOFF_SECONDS=900

# For OpenAI-compatible endpoints, use the base path without /chat/completions.
# Keep tokens in AI_API_KEY rather than embedding them in the URL.
# Example: AI_PROVIDER_BASE_URL=http://ai-host:20128/v1
