{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wazuh-mcp:cmdb:1.0.0",
  "title": "Wazuh MCP Asset CMDB",
  "type": "object",
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "assets": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "anyOf": [{"required": ["agent_id"]}, {"required": ["host"]}, {"required": ["ip"]}],
        "properties": {
          "id": {"type": "string", "maxLength": 256},
          "agent_id": {"type": "string", "maxLength": 256},
          "name": {"type": "string", "maxLength": 500},
          "host": {"type": "string", "maxLength": 256},
          "ip": {"type": "string", "maxLength": 256},
          "aliases": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 256}},
          "owner": {"type": "string", "maxLength": 500},
          "criticality": {"enum": ["critical", "high", "medium", "low"]},
          "environment": {"type": "string", "maxLength": 500},
          "network_zone": {"type": "string", "maxLength": 500},
          "application": {"type": "string", "maxLength": 500},
          "internet_exposed": {"type": "boolean"},
          "patch_state": {"enum": ["patched", "pending", "vulnerable", "not_applicable", "unknown"]},
          "last_verified": {"type": "string", "format": "date-time"},
          "vendor": {"type": "string", "maxLength": 500},
          "version": {"type": "string", "maxLength": 500},
          "cpe": {"type": "string", "pattern": "^cpe:2\\.3:[aoh]:"},
          "components": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": {"type": "string", "maxLength": 500},
                "vendor": {"type": "string", "maxLength": 500},
                "product": {"type": "string", "maxLength": 500},
                "version": {"type": "string", "maxLength": 500},
                "cpe": {"type": "string", "pattern": "^cpe:2\\.3:[aoh]:"},
                "patch_state": {"enum": ["patched", "pending", "vulnerable", "not_applicable", "unknown"]},
                "last_verified": {"type": "string", "format": "date-time"},
                "source": {"type": "string", "maxLength": 500}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
