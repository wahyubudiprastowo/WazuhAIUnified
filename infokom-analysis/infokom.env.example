# INFOKOM / Blue Team MCP sidecar
MCP_TRANSPORT=streamable_http
MCP_HOST=0.0.0.0
MCP_PORT=8000
INFOKOM_MCP_HOST_PORT=8000
BLUE_TEAM_MCP_SERVER_NAME=blue_team_mcp_infokom

# Generate with:
#   python3 -c "import secrets; print('btm_' + secrets.token_urlsafe(32))"
MCP_API_KEY=__GENERATED_INFOKOM_MCP_API_KEY__
MCP_API_KEY_SCOPES=wazuh:read wazuh:write
BLUETEAM_HTTP_RATE_LIMIT=120

# Wazuh Manager API
WAZUH_API_URL=https://wazuh.manager:55000
WAZUH_API_USER=__WAZUH_API_USER__
WAZUH_API_PASSWORD=__WAZUH_API_PASSWORD__
WAZUH_API_VERIFY_SSL=false

# Wazuh Indexer / OpenSearch
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USER=__WAZUH_INDEXER_USER__
WAZUH_INDEXER_PASSWORD=__WAZUH_INDEXER_PASSWORD__
WAZUH_INDEXER_VERIFY_SSL=false
WAZUH_INDEXER_MAX_SIZE=10000

# Runtime stores
BLUETEAM_AUDIT_LOG=/var/log/blue-team-mcp/audit.log
BLUETEAM_INVESTIGATION_HISTORY=/var/log/blue-team-mcp/investigation_history.jsonl
BLUETEAM_IOC_STORE=/var/log/blue-team-mcp/ioc_store.jsonl
# Transactional incident store. WAL/SHM files live beside this database and
# persist through the mounted runtime directory.
BLUETEAM_CASE_DB=/var/log/blue-team-mcp/cases.sqlite3
# Optional one-time legacy JSON/JSONL import source. The source is never deleted.
BLUETEAM_CASE_STORE=/var/log/blue-team-mcp/cases.json
BLUETEAM_FALSE_POSITIVE_KB=/var/log/blue-team-mcp/false_positive_kb.json
BLUETEAM_CMDB_FILE=/app/resource/assets.json
BLUETEAM_ATTACKER_REGISTRY=/var/log/blue-team-mcp/attacker_registry.jsonl
BLUETEAM_EXPORT_DIR=/var/log/blue-team-mcp/exports
BLUETEAM_CHARACTER_LIMIT=100000
BLUETEAM_REDACTION_POLICY=full
BLUETEAM_ALLOW_FORENSIC_BYPASS=false
LOG_LEVEL=INFO

# Optional external threat-intel/API providers. Empty means the related tool
# stays registered but returns a clear disabled/missing-key response.
CROWDSEC_API_KEY=
OTX_API_KEY=
THREATFOX_API_KEY=
URLHAUS_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
RAPIDAPI_KEY=
HUDSONROCK_API_KEY=
NVD_API_KEY=
CYFIRMA_BASE_URL=https://api.cyfirma.com
CYFIRMA_API_KEY=
CYFIRMA_TAILORED_IOC_PATH=/api/ex/v3/da/stix/2.1/indicators/tailored
CYFIRMA_GLOBAL_IOC_PATH=/api/ex/v3/da/stix/2.1/indicators/all
CYFIRMA_IOC_PATH=/api/ex/v3/da/stix/2.1/indicators/tailored
CYFIRMA_VERIFY_SSL=true
CYFIRMA_CACHE_TTL=1800

# Keep heavy local reranker/document conversion opt-in.
BLUETEAM_RERANK_ENABLED=false

# Existing Wazuh compose network
WAZUH_DOCKER_NETWORK=single-node_default
