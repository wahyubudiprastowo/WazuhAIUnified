# Wazuh + MCP AI Security Platform HLD overlay.
# Copy to hld.env and provide deployment-specific credentials.

WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=__WAZUH_INDEXER_PASSWORD__
WAZUH_INDEXER_VERIFY_SSL=false

MCP_URL=http://wazuh-main-server:3000
MCP_API_KEY=

MIN_ALERT_LEVEL=10
POLL_INTERVAL=10
LOOKBACK_MINUTES=30
WORKER_RUNTIME_DIR=/data

# Optional approval / SOAR notification endpoints.
# Leave empty to disable.
SOAR_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Keep false for production until an approval workflow exists.
ENABLE_AUTOMATED_RESPONSE=false
RESPONSE_MIN_LEVEL=12
RESPONSE_AGENT_ID=

# Optional Docker network override.
WAZUH_DOCKER_NETWORK=single-node_default
HLD_WORKER_UID=1000
HLD_WORKER_GID=1000
